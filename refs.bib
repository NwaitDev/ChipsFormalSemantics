@incollection{muller-schloer_organisation-oriented_2011,
	location = {Basel},
	title = {Organisation-Oriented Chemical Programming},
	isbn = {978-3-0348-0129-4 978-3-0348-0130-0},
	url = {https://link.springer.com/10.1007/978-3-0348-0130-0_13},
	doi = {10.1007/978-3-0348-0130-0_13},
	abstract = {Chemical information processing possesses a variety of valuable properties, such as robustness, concurrency, fault-tolerance and evolvability. However, it is diﬃcult to predict and program a chemical system because the computation emerges as a global phenomenon from microscopic reactions. For programming chemical systems a theoretical method to cope with that emergent behaviour is desirable. Here we will review design principles for chemical programs. We focus on programs that should compute a qualitative and not a quantitative result. The design principles are based on chemical organisation theory, which deﬁnes a chemical organisation as a closed and self-maintaining set of molecular species. The fundamental assumption of so called organisation-oriented programming is that computation should be understood as a movement between chemical organisations. In this case we expect that the resulting system is more robust and ﬁne-tuning of the kinetic laws will be less important. As examples for the usage of this design method we show a logic gate and a solution to the maximal independent set problem implemented as artiﬁcial chemistries.},
	pages = {207--220},
	booktitle = {Organic Computing — A Paradigm Shift for Complex Systems},
	publisher = {Springer Basel},
	author = {Matsumaru, Naoki and Kreyssig, Peter and Dittrich, Peter},
	editor = {Müller-Schloer, Christian and Schmeck, Hartmut and Ungerer, Theo},
	urldate = {2026-04-16},
	date = {2011},
	langid = {english},
	annotation = {Expresses how species introduced into a system realize control over the other species in the vessel
},
	file = {PDF:/home/agallone/Zotero/storage/A5CDJJWL/Matsumaru et al. - 2011 - Organisation-Oriented Chemical Programming.pdf:application/pdf},
}

