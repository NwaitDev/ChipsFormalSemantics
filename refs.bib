	file = {Full Text PDF:/home/agallone/Zotero/storage/BCM4FAUJ/Chapiro - 1984 - Globally-Asynchronous Locally-Synchronous Systems..pdf:application/pdf},
}

@article{jebali_formal_2016,
	title = {Formal modelling and verification of {GALS} systems using {GRL} and {CADP}},
	volume = {28},
	issn = {0934-5043, 1433-299X},
	url = {https://dl.acm.org/doi/10.1007/s00165-016-0373-3},
	doi = {10.1007/s00165-016-0373-3},
	abstract = {A {GALS} (Globally Asynchronous, Locally Synchronous) system consists of several synchronous components that evolve concurrently and interact with each other asynchronously. The design of {GALS} systems is tedious and error-prone due to the high degree of synchronous and asynchronous concurrency present in complex architectures. In this paper, we present {GRL} ({GALS} Representation Language), a formal language designed to model {GALS} systems, for the purpose of formal veriﬁcation of the asynchronous aspects. {GRL} combines the synchronous reactive model underlying dataﬂow languages and the asynchronous concurrent model underlying process algebras. We propose a translation from {GRL} to {LNT}, a value-passing concurrent language with classical process algebra ﬂavour. This makes possible the analysis of {GRL} speciﬁcations using all the state-of-the-art simulation and veriﬁcation functionalities provided by the {CADP} toolbox.},
	pages = {767--804},
	number = {5},
	journaltitle = {Formal Aspects of Computing},
	shortjournal = {Form. Asp. Comput.},
	author = {Jebali, Fatma and Lang, Frédéric and Mateescu, Radu},
	urldate = {2025-09-04},
	date = {2016-09},
	langid = {english},
	file = {PDF:/home/agallone/Zotero/storage/FWERFRDD/Jebali et al. - 2016 - Formal modelling and verification of GALS systems using GRL and CADP.pdf:application/pdf},
}

