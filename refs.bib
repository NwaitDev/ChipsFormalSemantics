	langid = {english},
	note = {Number: 1},
	file = {Texte intégral:/home/agallone/Zotero/storage/MKAE67FT/Alfonso et al. - 2021 - Self-adaptive architectures in IoT systems a systematic literature review.pdf:application/pdf},
}

