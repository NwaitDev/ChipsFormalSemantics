@thesis{sylvestre_programmation_2024,
	title = {Programmation sûre, expressive et efficace de circuits {FPGA}},
	url = {https://theses.hal.science/tel-04991551},
	abstract = {Field Programmable Gate Arrays ({FPGAs}) are digital circuits configurable from hardware descriptions at the register transfer ({RT}) level. The circuit behavior, as described at {RT} level, is expressed in terms of value transfers between registers synchronized by a physical clock. This makes it possible to implement reactive systems in the form of synchronous circuits that interact with their external environment. Such circuits continuously process inputs from their environment and “instantaneously” produce outputs to this environment, disregarding the propagation time of the electric current encoding the information. Computations can also be encoded at {RT} level; a division circuit in a processor, for example, returns a result after several clock cycles. However, the execution time of a computation generally depends on its inputs, as opposed to a reactive system. This thesis proposes an extension of the {RT} level with general-purpose programming features, in order to safely and efficiently express both computation and interaction. It presents the design and implementation of Eclat, a general-purpose, parallel and functional programming language, which has a temporal semantics guided by the {FPGA} target. Eclat is based on logical time in the manner of synchronous languages. The language is compiled to the {RT} level from which derives the logical time. In Eclat, the synchronous approach is used both to describe circuits at {RT} level and to reconcile determinism and fairness in programming parallelism with shared memory. Continuous interaction with the external environment has a direct impact on computation speed. The language can be used to develop programming abstractions, such as parallelism skeletons or virtual machines with predictable performance.This meets the need to execute general-purpose algorithms with shared memory into {FPGA}-based reactive embedded applications.},
	institution = {Sorbonne Université},
	type = {Theses},
	author = {Sylvestre, Loïc},
	urldate = {2026-04-22},
	date = {2024-11},
	note = {Issue: 2024SORUS539},
	keywords = {Synchronous programming, Conception et implantation de langage de programmation, {FPGA}, Functional programming, Programmation fonctionnelle, Programmation synchrone, Programming language design and implementation},
	file = {HAL PDF Full Text:/home/agallone/Zotero/storage/N68LEUKN/Sylvestre - 2024 - Programmation sûre, expressive et efficace de circuits FPGA.pdf:application/pdf},
}

@article{skillicorn_models_1998,
	title = {Models and languages for parallel computation},
	volume = {30},
	issn = {0360-0300, 1557-7341},
	url = {https://dl.acm.org/doi/10.1145/280277.280278},
	doi = {10.1145/280277.280278},
	abstract = {We survey parallel programming models and languages using six criteria to assess their suitability for realistic portable parallel programming. We argue that an ideal model should by easy to program, should have a software development methodology, should be architecture-independent, should be easy to understand, should guarantee performance, and should provide accurate information about the cost of programs. These criteria reflect our belief that developments in parallelism must be driven by a parallel software industry based on portability and efficiency. We consider programming models in six categories, depending on the level of abstraction they provide. Those that are very abstract conceal even the presence of parallelism at the software level. Such models make software easy to  build and port, but efficient and predictable performance is usually hard to achieve. At the other end of the spectrum, low-level models make all of the messy issues of parallel programming explicit (how many threads, how to place them, how to express communication, and how to schedule communication), so that software is hard to build and not very portable, but is usually efficient. Most recent models are near the center of this spectrum, exploring the best tradeoffs between expressiveness and performance. A few models have achieved both abstractness and efficiency. Both kinds of models raise the possibility of parallelism as part of the mainstream of computing.},
	pages = {123--169},
	number = {2},
	journaltitle = {{ACM} Computing Surveys},
	shortjournal = {{ACM} Comput. Surv.},
	author = {Skillicorn, David B. and Talia, Domenico},
	urldate = {2026-04-24},
	date = {1998-06},
	langid = {english},
	file = {PDF:/home/agallone/Zotero/storage/6E3NPIX2/Skillicorn et Talia - 1998 - Models and languages for parallel computation.pdf:application/pdf},
}

